<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
@font-face{font-family:'SG';src:url('{{ fonts }}/SpaceGrotesk.ttf') format('truetype');font-weight:300 700}
@font-face{font-family:'JBM';src:url('{{ fonts }}/JetBrainsMono.ttf') format('truetype');font-weight:100 800}
*{box-sizing:border-box}
body{margin:0;background:#0B1020}
/* 1080x1920. Padding keeps content out of Instagram's overlays:
   top 230 (Reels header), right 150 (like/comment/share buttons), bottom 440 (username + caption). */
.scene{position:relative;width:1080px;height:1920px;overflow:hidden;background-color:#0B1020;
  background-image:radial-gradient(rgba(148,163,184,.11) 1.5px,transparent 1.6px);background-size:40px 40px;
  font-family:'SG',sans-serif;color:#F8FAFC;padding:230px 150px 440px 84px;display:flex;flex-direction:column}
.halo{position:absolute;right:-300px;top:-200px;width:900px;height:900px;border-radius:50%;
  background:radial-gradient(circle,{{ accent }}26 0%,transparent 65%);pointer-events:none}
.halo2{position:absolute;left:-360px;bottom:120px;width:800px;height:800px;border-radius:50%;
  background:radial-gradient(circle,#8B5CF61a 0%,transparent 65%);pointer-events:none}
.top{display:flex;justify-content:space-between;align-items:center;position:relative}
.kicker{font-family:'JBM',monospace;font-size:26px;letter-spacing:.14em;color:{{ accent }};
  border:2px solid {{ accent }};border-radius:999px;padding:12px 24px;text-transform:uppercase}
.count{font-family:'JBM',monospace;font-size:28px;color:#94A3B8}
.progress{position:relative;height:8px;border-radius:4px;background:#1E2742;margin-top:30px}
.progress span{position:absolute;left:0;top:0;bottom:0;border-radius:4px;background:{{ accent }}}
.main{--k:1;flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column;justify-content:safe center;
  gap:calc(40px*var(--k));position:relative;padding:30px 0}
.hl{color:{{ accent }}}
.main>*{flex-shrink:0}  /* never squeeze a block (e.g. the code box); overflow must show so fitAll can shrink text */
.idx{font-weight:700;font-size:calc(200px*var(--k));line-height:.8;color:transparent;-webkit-text-stroke:3px {{ accent }};opacity:.6;letter-spacing:-.02em}
h1{margin:0;font-weight:700;letter-spacing:-.03em;line-height:1;font-size:calc(140px*var(--k))}
h2{margin:0;font-weight:700;letter-spacing:-.02em;line-height:1.05;font-size:calc(100px*var(--k))}
.text{margin:0;font-size:calc(56px*var(--k));line-height:1.35;color:#C3CCDD;overflow-wrap:anywhere}
.code{background:#080C18;border:2px solid #2A3658;border-radius:28px;overflow:hidden}
.code .bar{display:flex;gap:12px;padding:18px 24px;background:#121A33}
.code .bar i{width:16px;height:16px;border-radius:50%;display:block}
.code pre{margin:0;padding:calc(28px*var(--k)) 30px;font-family:'JBM',monospace;font-size:calc(42px*var(--k));
  line-height:1.45;color:#E2E8F0;white-space:pre;overflow:hidden}
.code pre b{color:#22C55E;font-weight:600}
.foot{display:flex;align-items:center;gap:14px;position:relative;font-family:'JBM',monospace;font-size:30px;color:#C3CCDD}
.pill{align-self:flex-start;font-size:calc(50px*var(--k));font-weight:600;padding:26px 46px;border-radius:999px;
  border:3px solid #22D3EE;background:rgba(34,211,238,.12)}
.actions{display:flex;gap:18px;flex-wrap:wrap}
.actions span{font-family:'JBM',monospace;font-size:32px;color:#C3CCDD;border:2px solid #2A3658;border-radius:999px;padding:12px 26px}
</style>
</head>
<body>
{% macro logo(size) -%}
<svg viewBox="0 0 200 200" width="{{ size }}" height="{{ size }}" aria-hidden="true"><path d="M70 50 C56 50 55 60 55 74 L55 88 C55 96 50 100 41 100 C50 100 55 104 55 112 L55 126 C55 140 56 150 70 150" fill="none" stroke="#22D3EE" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"/><path d="M130 50 C144 50 145 60 145 74 L145 88 C145 96 150 100 159 100 C150 100 145 104 145 112 L145 126 C145 140 144 150 130 150" fill="none" stroke="#22D3EE" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"/><rect x="90" y="96" width="20" height="20" rx="4" fill="#F59E0B"/><circle cx="77" cy="108" r="8" fill="#F8FAFC"/><circle cx="85" cy="84" r="8" fill="#F8FAFC"/><circle cx="115" cy="84" r="8" fill="#F8FAFC"/><circle cx="123" cy="108" r="8" fill="#F8FAFC"/></svg>
{%- endmacro %}
{% macro chrome_top(i) -%}
<div class="halo"></div><div class="halo2"></div>
<div class="top"><div class="kicker">{{ kicker }}</div></div>
<div class="progress"><span style="width:{{ (100 * i / total) | round(1) }}%"></span></div>
{%- endmacro %}
{% macro foot() -%}
<div class="foot">{{ logo(56) }}<span>{{ handle }}</span></div>
{%- endmacro %}

<section class="scene" id="s1">
  {{ chrome_top(1) }}
  <div class="main">
    {{ logo(180) }}
    <h1>{{ post.hook.title | hl }}</h1>
  </div>
  {{ foot() }}
</section>

{% for s in post.scenes %}
<section class="scene" id="s{{ loop.index + 1 }}">
  {{ chrome_top(loop.index + 1) }}
  <div class="main">
    <div class="idx">{{ '%02d' % loop.index }}</div>
    <h2>{{ s.title | hl }}</h2>
    {% if s.text %}<p class="text">{{ s.text | hl }}</p>{% endif %}
    {% if s.code %}<div class="code"><div class="bar"><i style="background:#EF4444"></i><i style="background:#F59E0B"></i><i style="background:#22C55E"></i></div><pre>{{ s.code | codefmt }}</pre></div>{% endif %}
  </div>
  {{ foot() }}
</section>
{% endfor %}

<section class="scene" id="s{{ total }}">
  {{ chrome_top(total) }}
  <div class="main">
    <svg viewBox="0 0 24 24" width="140" height="140" fill="rgba(245,158,11,.18)" stroke="#F59E0B" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z"/></svg>
    <h1 style="font-size:calc(116px*var(--k))">{{ post.outro.title | hl }}</h1>
    <div class="pill">Follow {{ handle }}</div>
    <div class="actions"><span>Save</span><span>Share</span><span>Comment</span></div>
  </div>
  {{ foot() }}
</section>

<script>
// Shrink text until each scene fits, then report anything that still overflows.
window.fitAll = () => {
  const report = [];
  document.querySelectorAll('.scene').forEach((scene, i) => {
    const main = scene.querySelector('.main');
    let k = 1;
    const tooBig = () => main.scrollHeight > main.clientHeight + 1 ||
      [...main.querySelectorAll('pre, h1, h2')].some(e => e.scrollWidth > e.clientWidth + 1) ||
      [...main.querySelectorAll('pre')].some(e => e.scrollHeight > e.clientHeight + 1);
    while (tooBig() && k > 0.62) { k = +(k - 0.03).toFixed(2); main.style.setProperty('--k', k); }
    const problems = [];
    if (main.scrollHeight > main.clientHeight + 1) problems.push('text taller than the screen');
    main.querySelectorAll('pre').forEach(p => { if (p.scrollWidth > p.clientWidth + 1) problems.push('code line too wide');
      if (p.scrollHeight > p.clientHeight + 1) problems.push('code box cut off'); });
    main.querySelectorAll('h1, h2').forEach(h => { if (h.scrollWidth > h.clientWidth + 1) problems.push('a title word is too long'); });
    report.push({slide: i + 1, scale: k, problems});
  });
  return report;
};

// Motion. seek(i, t) puts scene i in the state it has t seconds after it starts, so Python can
// screenshot any moment frame by frame (no real-time playback, so no dropped or uneven frames).
// Elements rise in one after another, code lines appear one by one, the progress bar slides forward.
// After introLength(i) seconds the scene looks exactly like its still frame (slide-NN.jpg).
const STEP = 0.14, DUR = 0.5, LINE = 0.28, BAR = 0.6;
const clamp = x => Math.min(Math.max(x, 0), 1);
const ease = x => 1 - Math.pow(1 - clamp(x), 3);
const sceneParts = i => {
  const scene = document.getElementById('s' + i);
  if (!scene._parts) {
    scene.querySelectorAll('.code pre').forEach(pre => {
      pre.innerHTML = pre.innerHTML.split('\n').map(l => `<span class="ln">${l}</span>`).join('\n');
    });
    const items = [...scene.querySelectorAll('.kicker, .main > *')];
    const code = scene.querySelector('.main > .code');
    const bar = scene.querySelector('.progress span');
    scene._parts = {items, bar, end: parseFloat(bar.style.width) || 0,
      lines: [...scene.querySelectorAll('.code .ln')],
      codeAt: code ? items.indexOf(code) * STEP + DUR * 0.6 : 0};
  }
  return scene._parts;
};
window.introLength = i => {
  const p = sceneParts(i);
  return Math.max(p.items.length * STEP + DUR, BAR, p.lines.length ? p.codeAt + p.lines.length * LINE + 0.2 : 0);
};
window.seek = (i, t) => {
  const p = sceneParts(i);
  p.items.forEach((el, j) => {
    const k = ease((t - j * STEP) / DUR);
    el.style.opacity = k;
    if (el.classList.contains('idx')) { el.style.transformOrigin = 'left center'; el.style.transform = `scale(${0.5 + 0.5 * k})`; }
    else el.style.transform = `translateY(${(1 - k) * 70}px)`;
  });
  p.lines.forEach((ln, j) => { ln.style.opacity = clamp((t - p.codeAt - j * LINE) / 0.12); });
  const start = i > 1 ? 100 * (i - 1) / {{ total }} : 0;
  p.bar.style.width = (start + (p.end - start) * ease(t / BAR)) + '%';
};
</script>
</body>
</html>
