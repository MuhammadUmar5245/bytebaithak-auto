# ===== ByteBaithak automation settings =====
# Is file ko copy karke ".env" naam se save karein, phir values bharein.
# .env kabhi kisi ko na bhejein aur GitHub par na daalein, us mein aap ki keys hain.

HANDLE=@byte_baithak
CONTENT_LANGUAGE=English

# ---- AI (free options) ----
LLM_PROVIDER=gemini
LLM_FALLBACK=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
VISION_CHECK=true

# ---- Reels voice (Kokoro, offline) ----
REEL_VOICE=bm_george
REEL_SPEED=1.0

# ---- Schedule (Pakistan time). Post times come from data/calendar.csv ----
GENERATE_AT=06:00
CATCHUP_HOURS=3

# ---- Safety ----
DRY_RUN=true
APPROVAL_MODE=all

# ---- Approvals chat: discord (default), telegram, ya none ----
NOTIFY=discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bytebaithak-media
R2_PUBLIC_BASE_URL=

# ---- Instagram API ----
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v24.0
